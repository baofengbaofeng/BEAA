{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BEAA Policy",
  "type": "object",
  "required": [
    "version",
    "periodMinutes",
    "dailyLimitMinutes",
    "restMinutes",
    "questionCount",
    "requiredCorrect",
    "grade",
    "subjects"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "periodMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120,
      "default": 30
    },
    "dailyLimitMinutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 600,
      "default": 120
    },
    "restMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "default": 10
    },
    "questionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5
    },
    "requiredCorrect": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5,
      "description": "Must be <= questionCount; validated by business engine"
    },
    "grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "default": 3
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "chinese",
          "math",
          "english"
        ]
      }
    }
  }
}
