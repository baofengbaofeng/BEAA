{
  "name": "beaa-core-prototype",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test shared/domain/*.test.mjs shared/quiz/*.test.mjs tests/*.test.mjs",
    "demo": "node shared/domain/demo.mjs",
    "test:browser": "npm run build:browser-check && npm run build:starter-bank && playwright test",
    "build:demo": "python3 scripts/package-demo.py",
    "native:preflight": "node scripts/native-preflight.mjs",
    "demo:sqlite": "node apps/node-reference/demo.mjs",
    "backup:sqlite": "node apps/node-reference/backup.mjs backup",
    "inspect:sqlite": "node apps/node-reference/backup.mjs inspect",
    "demo:parent": "node apps/node-reference/parent-demo.mjs",
    "build:browser-check": "python3 scripts/package-browser-check.py",
    "demo:device": "node apps/node-reference/device-demo.mjs",
    "demo:bank": "node apps/node-reference/question-bank-demo.mjs",
    "demo:reminders": "node apps/node-reference/reminder-demo.mjs",
    "build:starter-bank": "node scripts/package-starter-bank.mjs",
    "sync:preview": "node scripts/embed-preview-domain.mjs",
    "check:sources": "node scripts/build-native-reading.mjs --check && node scripts/embed-family.mjs --check && node scripts/embed-pinyin.mjs --check && node scripts/embed-preview-domain.mjs --check && node scripts/package-native-preview.mjs --check && npm run check:native-core",
    "build:native-preview": "node scripts/package-native-preview.mjs",
    "build:delivery": "python3 scripts/package-delivery.py",
    "check:native-core": "node scripts/native-core.mjs",
    "demo:notifications": "node apps/node-reference/notification-demo.mjs",
    "sync:pinyin": "node scripts/embed-pinyin.mjs",
    "sync:family": "node scripts/embed-family.mjs",
    "build:curriculum": "node scripts/build-curriculum.mjs",
    "family:serve": "node apps/family-service/server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "json5": "2.2.3",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "pinyin-pro": "3.29.5"
  }
}
